# Copy this file to `.env` and fill in real values before deploying:
#   cp .env.prod.example .env
# docker-compose.prod.yml reads these. `.env` is gitignored — never commit secrets.

# --- MongoDB (bundled container) ---
MONGO_ROOT_USERNAME=habit_admin
# Use a long random password, e.g.: openssl rand -base64 24
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password
MONGO_DB=habit_tracker

# --- Backend ---
# Secret used to sign JWTs. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed browser origins for the API.
#   *  = allow any origin (fine for quick user testing; simplest)
# For a locked-down deploy, set this to your exact URL instead, e.g.:
#   CORS_ORIGINS=https://habits.example.com
CORS_ORIGINS=*
